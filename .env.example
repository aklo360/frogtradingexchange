# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit real credentials to git. Use .env.local for local dev.
# 2. For production: use Cloudflare Workers Secrets (`wrangler secret put`)
# 3. NEVER use NEXT_PUBLIC_* prefix for sensitive values - they get bundled
#    into client-side JavaScript and are visible to all users
# 4. Rotate credentials regularly and after any suspected exposure
# 5. Use environment-specific credentials for dev/staging/prod
# =============================================================================

# Titan API credentials (keep real values in `.env.local` or Wrangler secrets)
TITAN_BASE_URL=https://{region}.api.demo.titan.exchange/api/v1
TITAN_WS_URL=wss://{region}.api.demo.titan.exchange/api/v1/ws
TITAN_TOKEN=replace-with-your-token
TITAN_REGION_ORDER=us1,de1,jp1

# Quote freshness in seconds (default is 3)
QUOTE_FRESHNESS_SECONDS=10

# Worker-only Solana RPC endpoints (keep private - NEVER expose these)
# SECURITY: These are server-side only. Use /rpc proxy for frontend.
SOLANA_RPC_URL=https://your-private-solana-rpc.example.com
SOLANA_WS_URL=wss://your-private-solana-rpc.example.com

# Optional overrides for the Pages worker proxy
# API_ORIGIN=https://frogx-api.aklo.workers.dev

# Client-side overrides (CAUTION: NEXT_PUBLIC_* values are exposed to users!)
# SECURITY WARNING: Do NOT put API keys in NEXT_PUBLIC variables!
# Use the /rpc proxy endpoint instead of exposing RPC URLs directly.
# NEXT_PUBLIC_API_BASE_URL=https://frogx-api.aklo.workers.dev
# NEXT_PUBLIC_SOLANA_RPC_URL=https://your-public-or-dev-only-solana-rpc.example.com
# NEXT_PUBLIC_FROGX_VERSION=v1
# Privy app/signer/policy IDs are public identifiers. Never expose the app
# secret or authorization private key through NEXT_PUBLIC variables.
# NEXT_PUBLIC_PRIVY_APP_ID=replace-with-privy-app-id
# NEXT_PUBLIC_PRIVY_BOT_SIGNER_ID=replace-with-authorization-key-id
# NEXT_PUBLIC_PRIVY_BOT_POLICY_IDS=policy_id_1,policy_id_2

# Platform fee configuration (1% default). Ensure fee collector ATAs exist for minted tokens.
PLATFORM_FEE_ENABLED=true
PLATFORM_FEE_BPS=100
PLATFORM_FEE_RECIPIENT=FRoGhxGx2kugimLMTiq3qra7yarFmnfpm6E3y38myzWh
# Optional explicit token accounts for fee collection when not using auto-derived ATAs.
PLATFORM_FEE_SOL_ACCOUNT=8ZS7hMekbggef1a2cbHj3U7UebLB4qWHH9PyGd6RMdye
PLATFORM_FEE_USDC_ACCOUNT=7NcR9WU2kzJV1RcN9NcGXakkbU9289rxZdAoyMxNuCsE
PLATFORM_FEE_USDT_ACCOUNT=7a2LNckdNtNFneyTiYiz5uZTYiL79vZvBUKPFCT2MXBa

# Ribbot Telegram trading bot wallet provisioning (Cloudflare Worker)
# SECURITY: Set real values with `wrangler secret put`, not committed env files.
# PRIVY_APP_ID=replace-with-privy-app-id
# PRIVY_APP_SECRET=replace-with-privy-app-secret
# PRIVY_API_BASE_URL=https://api.privy.io/v1
# Optional signer and wallet policy configuration for later live trading.
# PRIVY_AUTHORIZATION_KEY_ID=replace-with-privy-authorization-key-id
# PRIVY_AUTHORIZATION_PRIVATE_KEY=replace-with-authorization-private-key
# PRIVY_WALLET_POLICY_IDS=policy_id_1
# Existing deployments may use PRIVY_SIGNER_ID as the authorization-key ID alias.
# SECURITY: Shared bot-to-FTX auth token. Ribbot sends this as RIBBOT_FTX_API_TOKEN.
# RIBBOT_TRADING_BOT_TOKEN=replace-with-random-token
# Existing deployments may use FROGX_BOT_API_TOKEN as the Worker-side token alias.
# SECURITY: Separate operator-only token for the pull-based manual-review
# queue and evidence-only reconciliation actions. Never put this in Ribbot or
# a browser bundle; set it with `wrangler secret put` in approved environments.
# TRADING_BOT_OPERATOR_TOKEN=replace-with-separate-random-token
# Optional browser URL Ribbot should show with short-lived account control codes.
# RIBBOT_CONTROL_URL=https://frogtrading.exchange/ribbot
# Optional Privy-authenticated app URL for wallet claim/export handoff. The
# Worker records claim/export requests but never returns private keys.
# RIBBOT_WALLET_CLAIM_URL=https://frogtrading.exchange/ribbot
# Hard FTX-side live execution gate for Ribbot market orders. Keep false until
# Privy signer policy, simulation, monitoring, and rollback procedures are approved.
# TRADING_BOT_LIVE_EXECUTION_ENABLED=false
# Optional: ask Privy to sponsor Solana gas on signAndSendTransaction.
# TRADING_BOT_SOLANA_GAS_SPONSORSHIP_ENABLED=false
# Optional scheduled-order scanner. Keep false until staged order monitoring
# is approved. Live scheduler execution also requires
# TRADING_BOT_LIVE_EXECUTION_ENABLED=true and Privy signer readiness.
# TRADING_BOT_SCHEDULER_ENABLED=false
# TRADING_BOT_SCHEDULER_LIVE_EXECUTION_ENABLED=false
# TRADING_BOT_SCHEDULER_MAX_ORDERS=25
# TRADING_BOT_SCHEDULER_RECONCILE_AFTER_SECONDS=60
# Optional advanced automation monitor scanner. Keep false until advanced
# observation is approved. This records non-secret monitor state by default; it
# does not build sniper swaps, sign, or broadcast. Copytrade, auto-buy, and
# auto-sell execution require the extra live gates below.
# TRADING_BOT_ADVANCED_MONITOR_ENABLED=false
# TRADING_BOT_COPYTRADE_MONITOR_ENABLED=false
# Extra copytrade live execution gate. Also requires
# TRADING_BOT_LIVE_EXECUTION_ENABLED=true, parsed target transaction checks,
# SOL balance or token-position checks, market-risk checks for copied buys, and
# Privy signer readiness.
# TRADING_BOT_COPYTRADE_LIVE_EXECUTION_ENABLED=false
# TRADING_BOT_SNIPER_MONITOR_ENABLED=false
# Extra sniper live execution gate. The monitor reads Jupiter Tokens V2 recent
# first-pool data and still requires account sniper opt-in, source matching,
# cooldown/deduplication, max-snipes/max-spend caps, SOL balance, token safety,
# market-risk quote probing, the base live gate, and Privy signer readiness.
# TRADING_BOT_SNIPER_LIVE_EXECUTION_ENABLED=false
# TRADING_BOT_SNIPER_COOLDOWN_SECONDS=60
# TRADING_BOT_AUTO_BUY_MONITOR_ENABLED=false
# Extra auto-buy live execution gate. Also requires account auto-buy opt-in,
# TRADING_BOT_LIVE_EXECUTION_ENABLED=true, Solana RPC positions/token safety,
# market-risk quote probing, and Privy signer readiness.
# TRADING_BOT_AUTO_BUY_LIVE_EXECUTION_ENABLED=false
# Extra bundle-buy live execution gate for user-triggered basket execution.
# Also requires TRADING_BOT_LIVE_EXECUTION_ENABLED=true, Solana RPC balance,
# market-risk quote probing for every basket item, and Privy signer readiness.
# TRADING_BOT_BUNDLE_BUY_LIVE_EXECUTION_ENABLED=false
# TRADING_BOT_AUTO_SELL_MONITOR_ENABLED=false
# Extra auto-sell live execution gate. Also requires account auto-sell opt-in,
# TRADING_BOT_LIVE_EXECUTION_ENABLED=true, Solana RPC positions, and Privy signer readiness.
# TRADING_BOT_AUTO_SELL_LIVE_EXECUTION_ENABLED=false
# TRADING_BOT_ADVANCED_MONITOR_MAX_CONFIGS=25
# Minimum age before an ambiguous advanced execution is checked through Privy.
# TRADING_BOT_ADVANCED_RECONCILE_AFTER_SECONDS=60
# Shared age after which any still-unresolved direct, scheduled, bundle, or
# advanced execution is flagged for manual review. Review never retries,
# resends, or changes terminal state automatically.
# TRADING_BOT_MANUAL_REVIEW_AFTER_SECONDS=900
# Optional price source for Ribbot PNL cards. Set JUPITER_API_KEY as a Worker
# secret if using api.jup.ag plan/rate limits that require it.
# JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
# JUPITER_TOKENS_API_URL=https://api.jup.ag/tokens/v2/recent
# JUPITER_API_KEY=replace-with-jupiter-api-key

# Buyback automation (Cloudflare Worker)
BUYBACK_ENABLED=true
BUYBACK_DRY_RUN=false
BUYBACK_BURN_ENABLED=true
# SECURITY: Store wallet secret using `wrangler secret put BUYBACK_WALLET_SECRET`
# NEVER store private keys in plaintext files that could be committed to git!
# BUYBACK_WALLET_SECRET=base58-or-json-array-secret-key
BUYBACK_WALLET_ADDRESS=FRoGhxGx2kugimLMTiq3qra7yarFmnfpm6E3y38myzWh
BUYBACK_SOL_RESERVE=0.05
BUYBACK_MIN_SWAP_USDC=1
BUYBACK_MIN_SWAP_USDT=1
BUYBACK_TOKEN_RESERVE_USDC=1
BUYBACK_TOKEN_RESERVE_USDT=1
BUYBACK_TOKEN_RESERVE_WSOL=1
BUYBACK_SWAP_SLIPPAGE_BPS=100
BUYBACK_PRIORITY_FEE=0
# SECURITY: Required for buyback endpoints. Generate with: openssl rand -hex 32
# BUYBACK_TRIGGER_TOKEN=replace-with-random-token

# Magic Eden buyback API
ME_API_BASE_URL=https://api-mainnet.magiceden.dev/v2
# ME_API_KEY=replace-with-magic-eden-api-key
# ME_API_KEY_HEADER=Authorization
# ME_API_KEY_PREFIX=Bearer
ME_COLLECTION_SYMBOL=solana_business_frogs
ME_STATS_PATH=/collections/{symbol}/stats
ME_LISTINGS_PATH=/collections/{symbol}/listings
ME_LISTINGS_QUERY=offset=0&limit=1&sort=price
ME_BUY_NOW_PATH=/instructions/buy_now
ME_BUY_NOW_METHOD=GET
ME_FLOOR_PRICE_UNIT=lamports

# Sol Incinerator API
# SOL_INCINERATOR_API_URL=https://v1.api.sol-incinerator.com
# SOL_INCINERATOR_API_KEY=replace-with-incinerator-key
# SOL_INCINERATOR_API_KEY_HEADER=x-api-key
# SOL_INCINERATOR_API_KEY_PREFIX=
# SOL_INCINERATOR_BURN_PATH=/burn
# SOL_INCINERATOR_BURN_METHOD=POST

